# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase) ---------------------------------------------
# Supabase dashboard → Connect → "Session pooler" (IPv4-friendly).
# The direct db.<ref>.supabase.co host is IPv6-only.
DB_HOST=aws-<n>-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_DATABASE=postgres
# SSL is required by Supabase. Set to false only for a local Postgres without SSL.
DB_SSL=true

# --- Admin login (lib/auth.ts, /api/login) ---------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>
# Generate with: openssl rand -base64 48
JWT_SECRET=<random-secret>
